# --- Obbligatorie ---
DATABASE_URL=postgres://dressit:dressit@localhost:5432/dressit
JWT_SECRET=cambia-questa-stringa-con-almeno-32-caratteri-casuali
GEMINI_API_KEY=AIza...

# --- Opzionali ---
# Modello Gemini usato per vision e outfit (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Origini consentite dal CORS, separate da virgola (es. https://lorenzomp7.github.io)
CORS_ORIGIN=http://localhost:3000
# Se presente le immagini vanno su Cloudinary, altrimenti su disco locale (./uploads)
CLOUDINARY_URL=
# URL pubblico dell'API (sulla VM lo imposta il workflow di deploy)
PUBLIC_API_URL=http://localhost:4000
# true se il DB richiede SSL (es. un Postgres gestito esterno)
DATABASE_SSL=false
PORT=4000
# Email degli amministratori, separate da virgola (accesso a /admin)
ADMIN_EMAILS=
# Ospiti (accesso senza account): accesso rinnovato a ogni uso, cancellati con le foto
# dopo questi giorni senza aprire l'app. Gli account con email non vengono mai cancellati.
GUEST_INACTIVE_DAYS=90
