# --- Obbligatorie ---
DATABASE_URL=postgres://dressit:dressit@localhost:5432/dressit
JWT_SECRET=cambia-questa-stringa-con-almeno-32-caratteri-casuali
GEMINI_API_KEY=AIza...

# --- Opzionali ---
# Modello Gemini usato per vision e outfit (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Origini consentite dal CORS, separate da virgola (es. https://dressit-web.onrender.com)
CORS_ORIGIN=http://localhost:3000
# Se presente le immagini vanno su Cloudinary, altrimenti su disco locale (./uploads)
CLOUDINARY_URL=
# URL pubblico dell'API (su Render viene letto da RENDER_EXTERNAL_URL)
PUBLIC_API_URL=http://localhost:4000
# true se il DB richiede SSL (es. External Database URL di Render)
DATABASE_SSL=false
PORT=4000
