{
  "mcpServers": {
    "playwriter": {
      "command": "npm",
      "args": [
        "run",
        "--silent",
        "agent:browser"
      ]
    },
    "vibetest": {
      "command": "bash",
      "args": [
        "scripts/agents/vibetest.sh"
      ]
    },
    "container-use": {
      "command": "bash",
      "args": [
        "scripts/agents/container-use.sh",
        "stdio"
      ]
    },
    "rea": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.10.1",
        "mcp"
      ],
      "env": {
        "REA_MCP_TOOL_FAMILIES": "android,adb,apktool,session"
      }
    }
  }
}
